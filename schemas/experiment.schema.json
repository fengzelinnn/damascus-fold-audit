{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:damascus-fold-a:experiment:v1",
  "title": "A-group evidence record (not a data collection authorization)",
  "description": "JSONL stores one record per observation. Cross-record identity, time partitions, new-epoch uniqueness and actual artifact lengths/hashes require independent aggregate.py validation. All fixture data is NON-PAPER.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "data_kind": {
      "enum": [
        "fixture",
        "correctness_test",
        "local_measured",
        "published"
      ]
    },
    "experiment": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "correctness"
      ]
    },
    "scheme": {
      "type": "string",
      "minLength": 1
    },
    "scheme_version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "parameter_id": {
      "type": "string",
      "minLength": 1
    },
    "hardware_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64}|unresolved)$"
    },
    "backend": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requested",
        "actual",
        "fallback_reason"
      ],
      "additionalProperties": false
    },
    "cache": {
      "enum": [
        "cold",
        "warm",
        "none"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ok",
        "timeout",
        "oom",
        "parameter_rejected",
        "error"
      ]
    },
    "file_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "hardware_description": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "non_paper": {
          "type": "boolean"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "build_description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "measurement_method",
        "hardware_description",
        "timestamp_utc"
      ],
      "additionalProperties": false
    },
    "setup_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "prove_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "verify_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "stages_ns": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "parsing_context": {
              "type": "integer",
              "minimum": 0
            },
            "challenges": {
              "type": "integer",
              "minimum": 0
            },
            "generator_replay": {
              "type": "integer",
              "minimum": 0
            },
            "commitment_parity": {
              "type": "integer",
              "minimum": 0
            },
            "norm": {
              "type": "integer",
              "minimum": 0
            },
            "opening": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "parsing_context",
            "challenges",
            "generator_replay",
            "commitment_parity",
            "norm",
            "opening",
            "other"
          ],
          "additionalProperties": false
        }
      ]
    },
    "epoch": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "sequence_index": {
              "type": "integer",
              "minimum": 1
            },
            "audit_id": {
              "type": "string",
              "minLength": 1
            },
            "proof_id": {
              "type": "string",
              "minLength": 1
            },
            "registration_id": {
              "type": "string",
              "minLength": 1
            },
            "context_source": {
              "type": "string",
              "minLength": 1
            },
            "certified_new": {
              "type": "boolean"
            }
          },
          "required": [
            "sequence_index",
            "audit_id",
            "proof_id",
            "registration_id",
            "context_source",
            "certified_new"
          ],
          "additionalProperties": false
        }
      ]
    },
    "serialization": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "wire_profile": {
              "type": "string",
              "minLength": 1
            },
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "full_proof": {
              "$ref": "#/$defs/artifact"
            },
            "registration": {
              "$ref": "#/$defs/artifact"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "header",
                      "context",
                      "challenge",
                      "round_record",
                      "terminal_opening",
                      "other"
                    ]
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "artifact": {
                    "$ref": "#/$defs/artifact"
                  }
                },
                "required": [
                  "kind",
                  "offset",
                  "artifact"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "wire_profile",
            "codec",
            "full_proof",
            "registration",
            "parts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resources": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "peak_rss_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "sampled_peak_vram_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "vram_sampling_interval_ns": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      ]
    },
    "failure_reason": {
      "type": "string",
      "minLength": 1
    },
    "comparison": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "protocol_family": {
              "enum": [
                "public_low_storage_por",
                "epost",
                "damascus"
              ]
            },
            "guarantee": {
              "type": "string",
              "minLength": 1
            },
            "security_model": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "cost_scope": {
              "type": "string",
              "minLength": 1
            },
            "parameter_notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "protocol_family",
            "guarantee",
            "security_model",
            "source",
            "cost_scope",
            "parameter_notes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "parameter_schedule_id": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit shared parameter schedule when parameter_id varies with file_bytes. Independent aggregation requires exactly one parameter_id per file size across repeats, cache modes and platforms."
    }
  },
  "required": [
    "schema_version",
    "data_kind",
    "experiment",
    "scheme",
    "scheme_version",
    "profile",
    "protocol_hash",
    "parameter_id",
    "hardware_id",
    "backend",
    "cache",
    "run_id",
    "repetition",
    "status",
    "file_bytes",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "hex"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        },
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "hex"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_kind": {
            "const": "fixture"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "non_paper"
            ],
            "properties": {
              "non_paper": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_kind": {
            "enum": [
              "published",
              "local_measured"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "protocol_hash": {
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {
            "properties": {
              "non_paper": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "ok"
            }
          }
        }
      },
      "then": {
        "required": [
          "failure_reason"
        ]
      }
    }
  ]
}
